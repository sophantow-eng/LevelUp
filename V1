function pkmValid(o){
  if(!o||typeof o!=='object'||!Array.isArray(o.items))return 'File has no "items" list.';
  if(typeof o.v!=='number'||o.v>PKM_V)return 'Unsupported version ('+o.v+'). This app understands version '+PKM_V+'.';
  for(var i=0;i<o.items.length;i++){var x=o.items[i];if(!x||typeof x.id!=='string'||typeof x.title!=='string'||!PKM_T[x.type])return 'Item #'+(i+1)+' is invalid (needs id, title and a known type).';}
  return '';
}
function pkmExport(){var d={app:'LevelUp OS',v:PKM_V,exported:new Date().toISOString(),items:pkmItems()},b=new Blob([JSON.stringify(d,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='levelup-workspace-'+todayStr()+'.json';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},500);showToast('Backup downloaded');}
function pkmImportFile(inp){var f=inp.files&&inp.files[0];if(!f)return;var r=new FileReader();r.onload=function(){pkmImportText(String(r.result));inp.value='';};r.readAsText(f);}
function pkmImportText(txt){
  var o;try{o=JSON.parse(txt);}catch(e){showToast('Import failed: not valid JSON');return false;}
  var err=pkmValid(o);if(err){showToast('Import failed: '+err);return false;}
  if(!confirm('Replace your current '+pkmItems().length+' workspace items with '+o.items.length+' items from the file?'))return false;
  try{localStorage.setItem('levelup_pkm_safety_backup',JSON.stringify(pkmS()));}catch(e){}
  state.pkm={v:PKM_V,items:o.items.map(function(x){x.links=x.links||[];x.skills=x.skills||[];return x;})};saveData();showToast('Imported '+o.items.length+' items');render();return true;
}
function pkmWipe(){if(!confirm('Delete ALL workspace items? Export a backup first. This cannot be undone.'))return;try{localStorage.setItem('levelup_pkm_safety_backup',JSON.stringify(pkmS()));}catch(e){}state.pkm={v:PKM_V,items:[]};saveData();render();}
function renderPkm(){
  pkmS();var body;
  if(pkmEd)body=pkmForm();else if(pkmId)body=pkmDetail(pkmId);else if(pkmQ&&pkmV!=='data')body=pkmSearchView();
  else if(pkmV==='home')body=pkmHome();else if(pkmV==='data')body=pkmData();else body=pkmListView(pkmV);
  return '<h1 class="font-display font-bold text-2xl mb-3">🗂️ My Workspace</h1>'+pkmTabs()+body;
}

