function pkmSet(k,v){if(k==='q')pkmQ=v;else if(k==='tag')pkmTag=v;else if(k==='stat')pkmStat=v;else if(k==='fav')pkmFavOn=!pkmFavOn;else if(k==='arch')pkmArchOn=!pkmArchOn;render();}
function pkmMd(t){
  var out=[],code=false;String(t||'').split('\n').forEach(function(l){
    if(l.trim().indexOf('```')===0){out.push(code?'</pre>':'<pre class="p-3 rounded-lg bg-ink-100 dark:bg-ink-800 text-xs overflow-x-auto my-2">');code=!code;return;}
    if(code){out.push(esc(l)+'\n');return;}var e=esc(l),m;
    if((m=/^(#{1,3})\s+(.*)$/.exec(e)))out.push('<p class="font-semibold mt-3">'+m[2]+'</p>');
    else if((m=/^[-*]\s+\[( |x)\]\s+(.*)$/.exec(e)))out.push('<div>'+(m[1]==='x'?'☑':'☐')+' '+m[2]+'</div>');
    else if((m=/^[-*]\s+(.*)$/.exec(e)))out.push('<div>• '+m[1]+'</div>');
    else out.push(e?'<p>'+e+'</p>':'<br>');});
  if(code)out.push('</pre>');return out.join('');
}
