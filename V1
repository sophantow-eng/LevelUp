function kbDecks(){var m={};kbSt().qs.forEach(function(q){m[q.deck]=(m[q.deck]||0)+1;});return m;}
function kbPool(cat){
  var u=kbSt().qs;
  if(cat==='mix')return WF_Q.concat(kbSt().mix===false?[]:u.map(kbUQ));
  if(cat==='my')return u.map(kbUQ);
  if(String(cat).indexOf('deck:')===0){var d=cat.slice(5);return u.filter(function(x){return x.deck===d;}).map(kbUQ);}
  return WF_Q.filter(function(q){return q[0]===cat;});
}
function kbCats(){
  var out=CK_CATS.filter(function(c){return c[0]!=='mix';}).map(function(c){return [c[0],c[1],c[2],kbPool(c[0]).length];}),u=kbSt().qs,dk=kbDecks(),names=Object.keys(dk);
  if(u.length){out.push(['my','⭐','ของฉันทั้งหมด',u.length]);if(names.length>1)names.forEach(function(n){out.push(['deck:'+n,'📒',n,dk[n]]);});}
  out.push(['mix','🎲','ผสมทุกหมวด',kbPool('mix').length]);return out;
}
function kbMake(q){var idx=wfShuf(q[2].map(function(_,i){return i;}));return {c:q[0],q:q[1],o:idx.map(function(n){return q[2][n];}),a:idx.indexOf(0),e:q[3]||''};}
function kbExpHtml(e){return e?'<br><span class="text-xs text-ink-400">💡 '+esc(e)+'</span>':'';}
function kbValid(q,c,ws,e,deck){q=kbClean(q);c=kbClean(c);var w=[];ws.forEach(function(x){x=kbClean(x);if(x&&x!==c&&w.indexOf(x)<0)w.push(x);});
  if(!q||!c||w.length<2)return null;return {q:q,o:[c].concat(w.slice(0,3)),e:kbClean(e),deck:kbClean(deck)||'ของฉัน'};}
function kbAddQ(v){v.id='u'+Date.now()+Math.floor(Math.random()*100000);kbSt().qs.push(v);}
function kbSubmit(f){
  var g=function(n){return f.elements[n]?f.elements[n].value:'';},v=kbValid(g('q'),g('c'),[g('w1'),g('w2'),g('w3')],g('e'),g('deck')),s=kbSt();
  if(!v){showToast('ใส่คำถาม คำตอบที่ถูก และตัวเลือกผิดอย่างน้อย 2 ข้อ');render();return false;}
  if(kbEditId){var it=s.qs.filter(function(x){return x.id===kbEditId;})[0];if(it){it.q=v.q;it.o=v.o;it.e=v.e;it.deck=v.deck;}kbEditId=null;showToast('แก้ไขแล้ว');}
  else{kbAddQ(v);showToast('เพิ่มคำถามแล้ว (ทั้งหมด '+s.qs.length+' ข้อ)');}
  saveData();render();return false;
}
function kbBulk(f){
  var deck=f.elements.deck.value,ok=0,bad=0;
  f.elements.txt.value.split('\n').forEach(function(line){line=line.trim();if(!line)return;var p=line.split('|').map(kbClean);if(p.length<4){bad++;return;}
    var w=[p[2],p[3]],e='';if(p.length>=5)w.push(p[4]);if(p.length>=6)e=p[5];var v=kbValid(p[0],p[1],w,e,deck);if(!v){bad++;return;}kbAddQ(v);ok++;});
  showToast('นำเข้า '+ok+' ข้อ'+(bad?' · ข้าม '+bad+' บรรทัดที่รูปแบบไม่ถูก':''));saveData();render();return false;
}
function kbPairs(f){
  var deck=f.elements.deck.value,pairs=[];
  f.elements.txt.value.split('\n').forEach(function(l){var m=l.split(/\s*(?:=|→|\t)\s*/);if(m.length>=2&&kbClean(m[0])&&kbClean(m[1]))pairs.push([kbClean(m[0]),kbClean(m.slice(1).join(' = '))]);});
  if(pairs.length<3){showToast('ใส่อย่างน้อย 3 คู่ (คำ = ความหมาย)');render();return false;}
  var n=0;pairs.forEach(function(p,i){var wr=wfShuf(pairs.filter(function(x,j){return j!==i&&x[1]!==p[1];}).map(function(x){return x[1];})).slice(0,3);
    var v=kbValid('“'+p[0]+'” หมายถึงอะไร?',p[1],wr,'',deck);if(v){kbAddQ(v);n++;}});
  showToast('สร้างคำถามจากคู่คำศัพท์ '+n+' ข้อ');saveData();render();return false;
}
