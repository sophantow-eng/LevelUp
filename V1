function showToast(msg) {
  toastMsg = msg;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { toastMsg = null; renderToastOnly(); }, 2200);
}
function addXp(amount, label) {
  var today = todayStr();
  if (state.lastActiveDate !== today) {
    var yesterday = todayStr(-1);
    var twoDaysAgo = todayStr(-2);
    if (state.lastActiveDate === yesterday) {
      state.streak = state.streak + 1;
    } else if (state.streakShield && state.lastActiveDate === twoDaysAgo) {
      state.streak = state.streak + 1;
      state.streakShield = false;
      showToast('🧊 ใช้โล่ป้องกันสายแล้ว สายยังต่อเนื่อง!');
    } else {
      state.streak = 1;
    }
  }
  state.xp += amount;
  state.level = levelFromXp(state.xp);
  state.lastActiveDate = today;
  state.xpHistory.push({ date: today, amount: amount, label: label });
  if (state.xpHistory.length > 30) state.xpHistory = state.xpHistory.slice(-30);
  showToast('+' + amount + ' XP · ' + label);
}
function toggleTheme() { state.theme = state.theme === 'dark' ? 'light' : 'dark'; saveData(); render(); }

function fallbackBrowserDownload(htmlContent) {
  var blob = new Blob([htmlContent], { type: 'text/html' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = 'levelup-os.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  showToast('ดาวน์โหลดไฟล์แล้ว ✅');
}

function downloadHtmlFile() {
  var htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  if (window.claude && typeof window.claude.use === 'function') {
    window.claude.use('downloads').then(function (downloads) {
      if (!downloads) { fallbackBrowserDownload(htmlContent); return; }
      downloads.save({ filename: 'levelup-os.html', data: htmlContent }).then(function () {
        showToast('ดาวน์โหลดไฟล์แล้ว ✅');
      }).catch(function (err) {
        if (err && err.code === 'declined') return;
        console.error('ดาวน์โหลดผิดพลาด', err);
        showToast('ดาวน์โหลดไม่สำเร็จ ลองใหม่อีกครั้ง');
      });
    }).catch(function () { fallbackBrowserDownload(htmlContent); });
  } else {
    try { fallbackBrowserDownload(htmlContent); }
    catch (e) { console.error('ดาวน์โหลดผิดพลาด', e); showToast('ดาวน์โหลดไม่สำเร็จ ลองใหม่อีกครั้ง'); }
  }
}

function setQuestStatus(id, status) {
