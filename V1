function toggleFitnessToday(exId) {
  var today = todayStr();
  var current = state.fitness.log[today] || [];
  var has = current.indexOf(exId) !== -1;
  state.fitness.log[today] = has ? current.filter(function (x) { return x !== exId; }) : current.concat([exId]);
