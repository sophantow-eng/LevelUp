  var list = state[langKey].words;
  var word = list.filter(function (w) { return w.id === id; })[0];
  state[langKey].words = list.map(function (w) { return w.id === id ? Object.assign({}, w, { status: status }) : w; });
  if (status === 'mastered' && word && word.status !== 'mastered') addXp(8, 'จำคำว่า "' + word.word + '" ได้แล้ว (' + LANGUAGES[langKey].label + ')');
