<style>
/* ============ NOTEBOOK / STATIONERY THEME ============ */
:root{
  --nb-paper:#fcfbf7; --nb-line:#e5e7eb; --nb-margin:#fca5a5;
  --nb-yellow:#fef9c3; --nb-pink:#fce7f3; --nb-ink:#3a2f28; --nb-ink-soft:#6b5f52;
}
html:not(.dark), html:not(.dark) body{ background-color:var(--nb-paper); }
html:not(.dark) body{
  font-family:'Sarabun',sans-serif;
  background-color:#eaeaea;
  background-image:
    repeating-linear-gradient(180deg, transparent 0 47px, rgba(90,90,90,.5) 47px 49px),
    radial-gradient(circle, #fff 42%, rgba(90,90,90,.55) 46%, transparent 48%);
  background-size: 100% 49px, 26px 49px;
  background-position: 0 0, right 26px top 24px;
  background-repeat: repeat, repeat-y;
  background-attachment: fixed;
}
html:not(.dark) aside.bg-white, html:not(.dark) nav.bg-white{
  background-color:#eaeaea !important;
  background-image: repeating-linear-gradient(180deg, transparent 0 47px, rgba(90,90,90,.35) 47px 49px);
  background-size: 100% 49px;
}
.font-display{ font-family:'Kalam','Sarabun',cursive,sans-serif !important; letter-spacing:0 !important; }
h1.font-display, h2.font-display{ font-size:1.15em; }
.font-hand{ font-family:'Caveat','Kalam',cursive; }
/* paper cards with washi-tape corner + slight cozy tilt */
html:not(.dark) .card-premium{ background-color:#fff !important; border:1.5px solid var(--nb-line) !important; box-shadow:2px 3px 0 rgba(58,47,40,.06) !important; position:relative; }
html:not(.dark) .card-premium::before{ content:''; position:absolute; top:-9px; left:20px; width:52px; height:20px; background:rgba(252,231,243,.9); border:1px solid rgba(252,165,165,.45); transform:rotate(-4deg); border-radius:2px; box-shadow:0 1px 2px rgba(0,0,0,.1); pointer-events:none; }
html:not(.dark) .card-premium:hover{ box-shadow:4px 6px 0 rgba(58,47,40,.1) !important; }
/* base surfaces -> paper tones */
html:not(.dark) .bg-white{ background-color:#fff !important; }
