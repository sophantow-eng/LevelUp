  if (editCtx.type === 'exercise' && editCtx.list.length <= 1) { showToast('ต้องเหลืออย่างน้อย 1 ท่า'); return; }
  if (editCtx.type === 'budget') { delete state.finance.budgets[editCtx.id]; }
  else { editCtx.list.splice(editCtx.list.indexOf(editCtx.obj), 1); }
