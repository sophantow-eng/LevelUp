}
function completeQuest(id) {
  var quest = state.coding.quests.filter(function (q) { return q.id === id; })[0];
  if (!quest || quest.status === 'done') return;
  setQuestStatus(id, 'done');
  addXp(quest.xp, quest.title);
}
