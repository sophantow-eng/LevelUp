      v = n;
    } else if (editCtx.type !== 'profile' && EDIT_REQUIRED.indexOf(f[0]) !== -1 && !v) { showToast('กรุณากรอก' + f[1]); return; }
    out[f[0]] = v;
  }
  if (editCtx.type === 'budget') {
    var b = state.finance.budgets, nb = {};
    Object.keys(b).forEach(function (k) { if (k === editCtx.id) nb[out.name] = out.amount; else if (k !== out.name) nb[k] = b[k]; });
    state.finance.budgets = nb;
  } else { Object.assign(editCtx.obj, out); if (editCtx.image) editCtx.obj.image = editCtx.image; else delete editCtx.obj.image; }
  if (!saveData()) return;
