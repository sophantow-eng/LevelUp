  for (var i = 0; i < def.length; i++) {
    var f = def[i], el = document.getElementById('ef_' + f[0]), v = el ? el.value.trim() : '';
    if (f[2] === 'number') {
      var n = f[0] === 'year' ? parseInt(v, 10) : parseFloat(v);
