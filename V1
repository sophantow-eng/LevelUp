/* ============================== EVENT DELEGATION ============================== */
document.addEventListener('click', function (e) {
  var el = e.target.closest('[data-action]');
  if (!el) return;
  var action = el.dataset.action;
  var id = el.dataset.id;
  var status = el.dataset.status;

  if (action === 'nav') { activeTab = id; render(); return; }
  if (action === 'theme-toggle') { toggleTheme(); return; }
  if (action === 'complete-quest') { completeQuest(id); saveData(); render(); return; }
  if (action === 'quest-status') { setQuestStatus(id, status); saveData(); render(); return; }
  if (action === 'fitness-complete-all') { completeAllFitnessToday(); saveData(); render(); return; }
  if (action === 'lang-mode') { uiLangMode[activeTab] = id; uiReviewIdx[activeTab] = 0; uiReviewFlipped[activeTab] = false; render(); return; }
  if (action === 'word-status') { setWordStatus(activeTab, id, status); saveData(); render(); return; }
  if (action === 'review-flip') { uiReviewFlipped[activeTab] = !uiReviewFlipped[activeTab]; render(); return; }
  if (action === 'review-next') { uiReviewFlipped[activeTab] = false; uiReviewIdx[activeTab] = uiReviewIdx[activeTab] + 1; render(); return; }
  if (action === 'review-master') { setWordStatus(activeTab, id, 'mastered'); saveData(); uiReviewFlipped[activeTab] = false; render(); return; }
  if (action === 'math-reveal') { uiMathRevealed[id] = status; render(); return; }
  if (action === 'math-solve') { solveChallenge(id); saveData(); render(); return; }
  if (action === 'fitness-toggle') { toggleFitnessToday(id); saveData(); render(); return; }
  if (action === 'goal-add') { addToGoal(id, 500); saveData(); render(); return; }
  if (action === 'download-file') { downloadHtmlFile(); return; }
  if (action === 'toggle-github-guide') { uiShowGithubGuide = !uiShowGithubGuide; render(); return; }
});

document.addEventListener('change', function (e) {
  var el = e.target.closest('[data-action="project-status"]');
  if (el) { updateProjectStatus(el.dataset.id, el.value); saveData(); render(); }
});

document.addEventListener('submit', function (e) {
  var form = e.target.closest('form[data-form]');
  if (!form) return;
  e.preventDefault();
  var type = form.dataset.form;
  var fd = new FormData(form);

  if (type === 'add-quest') {
    var title = (fd.get('title') || '').toString().trim();
    if (!title) return;
    addQuest(title, fd.get('tech'));
  } else if (type === 'add-word') {
    var langKey = (fd.get('lang') || 'english').toString().trim();
    var word = (fd.get('word') || '').toString().trim();
    var thai = (fd.get('thai') || '').toString().trim();
    if (!word || !thai) return;
    addWord(langKey, word, thai, (fd.get('pronounce') || '').toString().trim(), (fd.get('example') || '').toString().trim());
  } else if (type === 'add-challenge') {
    var q = (fd.get('question') || '').toString().trim();
    var ans = (fd.get('answer') || '').toString().trim();
    if (!q || !ans) return;
