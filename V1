/* ============================== DERIVED STATS ============================== */
function langMastered(key) { return state[key].words.filter(function (w) { return w.status === 'mastered'; }).length; }
function langTotal(key) { return state[key].words.length; }

function computeStats() {
  var codingDone = state.coding.quests.filter(function (q) { return q.status === 'done'; }).length;
  var codingTotal = state.coding.quests.length;
  var mastered = langMastered('english');
  var wordsTotal = langTotal('english');
  var zhMastered = langMastered('chinese'), zhTotal = langTotal('chinese');
  var jaMastered = langMastered('japanese'), jaTotal = langTotal('japanese');
  var mathSolved = state.math.challenges.filter(function (c) { return c.solved; }).length;
  var mathTotal = state.math.challenges.length;

  var last7 = [];
  for (var i = 0; i < 7; i++) last7.push(todayStr(-i));
  var fitnessDaysDone = last7.filter(function (d) {
    return (state.fitness.log[d] || []).length === state.fitness.exercises.length;
  }).length;

  var spentByCat = {};
  state.finance.transactions.filter(function (t) { return t.type === 'expense'; }).forEach(function (t) {
    spentByCat[t.category] = (spentByCat[t.category] || 0) + t.amount;
  });
  var budgetKeys = Object.keys(state.finance.budgets);
  var catsWithinBudget = budgetKeys.filter(function (c) { return (spentByCat[c] || 0) <= state.finance.budgets[c]; }).length;
  var financeScore = budgetKeys.length ? (catsWithinBudget / budgetKeys.length) * 100 : 100;

  var skills = [
    { id: 'coding', label: 'โค้ดดิ้ง', pct: codingTotal ? (codingDone / codingTotal) * 100 : 0 },
    { id: 'english', label: 'ภาษาอังกฤษ', pct: wordsTotal ? (mastered / wordsTotal) * 100 : 0 },
    { id: 'chinese', label: 'ภาษาจีน', pct: zhTotal ? (zhMastered / zhTotal) * 100 : 0 },
    { id: 'japanese', label: 'ภาษาญี่ปุ่น', pct: jaTotal ? (jaMastered / jaTotal) * 100 : 0 },
    { id: 'math', label: 'คณิตศาสตร์', pct: mathTotal ? (mathSolved / mathTotal) * 100 : 0 },
    { id: 'fitness', label: 'ฟิตเนส', pct: (fitnessDaysDone / 7) * 100 },
    { id: 'finance', label: 'การเงิน', pct: financeScore }
  ];
  var weakest = skills.reduce(function (a, b) { return b.pct < a.pct ? b : a; }, skills[0]);

  return { codingDone: codingDone, codingTotal: codingTotal, mastered: mastered, wordsTotal: wordsTotal,
    zhMastered: zhMastered, zhTotal: zhTotal, jaMastered: jaMastered, jaTotal: jaTotal,
    mathSolved: mathSolved, mathTotal: mathTotal, fitnessDaysDone: fitnessDaysDone, spentByCat: spentByCat,
    financeScore: financeScore, skills: skills, weakest: weakest };
}

function computeTodaysTasks() {
  var tasks = [];
  var nextQuest = state.coding.quests.filter(function (q) { return q.status === 'in-progress'; })[0] ||
                  state.coding.quests.filter(function (q) { return q.status === 'todo'; })[0];
  if (nextQuest) {
    tasks.push({ id: 'task-coding', module: 'coding', icon: '💻', xp: nextQuest.xp,
      title: 'ทำเควส: ' + nextQuest.title, action: 'complete-quest', actionId: nextQuest.id });
  }
  var todayLog = state.fitness.log[todayStr()] || [];
  if (todayLog.length < state.fitness.exercises.length) {
    tasks.push({ id: 'task-fitness', module: 'fitness', icon: '💪', xp: 20,
      title: 'ทำเช็คลิสต์ออกกำลังกายวันนี้ให้ครบ', action: 'fitness-complete-all', actionId: '' });
  }
  var langLearning = ['english', 'chinese', 'japanese'].map(function (key) {
    return { key: key, count: state[key].words.filter(function (w) { return w.status === 'learning'; }).length };
  }).sort(function (a, b) { return b.count - a.count; })[0];
  if (langLearning && langLearning.count) {
    tasks.push({ id: 'task-lang', module: langLearning.key, icon: LANGUAGES[langLearning.key].icon, xp: 10,
      title: 'ทบทวนคำศัพท์' + LANGUAGES[langLearning.key].label + 'ที่ยังไม่เชี่ยวชาญ (' + langLearning.count + ' คำ)', action: 'nav', actionId: langLearning.key });
  }
  var nextChallenge = state.math.challenges.filter(function (c) { return !c.solved; })[0];
  if (nextChallenge) {
    tasks.push({ id: 'task-math', module: 'math', icon: '🧮', xp: 15,
      title: 'ลองแก้โจทย์คณิตศาสตร์ข้อใหม่', action: 'nav', actionId: 'math' });
