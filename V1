function pkmSave(f){
  var isNew=pkmEd&&pkmEd.indexOf('new:')===0,old=isNew?null:pkmFind(pkmEd),type=isNew?pkmEd.slice(4):old.type,bad='',val={};
  PKM_F[type].forEach(function(d){var v=(f.elements[d[0]]?f.elements[d[0]].value:'').trim();if(d[2]==='url'&&v&&!pkmUrl(v))bad=d[1];if(d[2]==='list')v=v.split(',').map(function(s){return s.trim();}).filter(Boolean);val[d[0]]=v;});
  if(!val.title){showToast('Title is required');return false;}
  if(bad){showToast('Invalid URL in "'+bad+'" — start with https://');return false;}
