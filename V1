}
function solveChallenge(id) {
  var c = state.math.challenges.filter(function (c) { return c.id === id; })[0];
  if (!c || c.solved) return;
  state.math.challenges = state.math.challenges.map(function (ch) { return ch.id === id ? Object.assign({}, ch, { solved: true }) : ch; });
  addXp(15, 'แก้โจทย์คณิตศาสตร์สำเร็จ');
}
