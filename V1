    '<button data-action="lang-mode" data-id="review" class="px-4 py-2 rounded-full text-sm font-semibold ' +
    (mode === 'review' ? 'bg-ink-900 dark:bg-amber-500 text-white dark:text-ink-950' : 'bg-white dark:bg-ink-900 border border-ink-200 dark:border-ink-800 text-ink-500') + '">โหมดทบทวน</button></div>';

  var body = '';
  if (mode === 'list') {
    var form = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">เพิ่มคำศัพท์ใหม่</h2>' +
      '<form data-form="add-word" class="grid sm:grid-cols-3 gap-2">' +
      '<input type="hidden" name="lang" value="' + langKey + '" />' +
      '<input name="word" placeholder="' + lang.wordLabel + '" required class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
      '<input name="thai" placeholder="ความหมาย (ไทย) — What / อะไร" required class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
      (lang.pronounceLabel ? '<input name="pronounce" placeholder="' + lang.pronounceLabel + '" class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' : '') +
      '<input name="example" placeholder="ประโยคตัวอย่าง" class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none ' + (lang.pronounceLabel ? '' : 'sm:col-span-1') + '" />' +
      '<button class="sm:col-span-3 px-5 py-3 rounded-xl bg-ink-900 dark:bg-amber-500 text-white dark:text-ink-950 text-base font-semibold">เพิ่มคำศัพท์</button></form>' + cardClose;

    var grid = '<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">' + state[langKey].words.map(function (w) {
      var btns = '';
      if (w.status !== 'learning') btns += '<button data-action="word-status" data-id="' + w.id + '" data-status="learning" class="text-xs px-2 py-1 rounded-md bg-ink-100 dark:bg-ink-800 text-ink-500">กำลังเรียน</button>';
      if (w.status !== 'mastered') btns += '<button data-action="word-status" data-id="' + w.id + '" data-status="mastered" class="text-xs px-2 py-1 rounded-md bg-teal-500/20 text-teal-600 dark:text-teal-400 font-semibold">จำได้แล้ว +XP</button>';
      btns += editBtn('word', w.id);
      return cardOpen() + imgThumb(w) + '<div class="flex items-start justify-between"><div><p class="font-display font-semibold">' + esc(w.word) + '</p>' +
        (w.pronounce ? '<p class="text-xs text-ink-400">' + esc(w.pronounce) + '</p>' : '') +
        '<p class="text-sm text-ink-500">' + esc(w.thai) + '</p></div>' +
        pill(w.status === 'mastered' ? 'เชี่ยวชาญ' : 'กำลังเรียน', w.status === 'mastered' ? 'bg-teal-500/15 text-teal-600 dark:text-teal-400' : 'bg-amber-500/15 text-amber-600 dark:text-amber-400') + '</div>' +
        (w.example ? '<p class="text-xs italic text-ink-400 mt-2">"' + esc(w.example) + '"</p>' : '') +
        '<div class="flex gap-1.5 mt-3 flex-wrap">' + btns + '</div>' + cardClose;
    }).join('') + '</div>';

    body = form + grid;
  } else {
    var learningWords = state[langKey].words.filter(function (w) { return w.status === 'learning'; });
    if (uiReviewIdx[langKey] >= learningWords.length) uiReviewIdx[langKey] = 0;
    var inner = '';
    if (!learningWords.length) {
      inner = '<p class="text-sm text-ink-400 py-10">ไม่มีคำที่ต้องทบทวนแล้ว เก่งมาก! 🎉</p>';
    } else {
      var w = learningWords[uiReviewIdx[langKey]];
      var flipped = uiReviewFlipped[langKey];
      inner = '<p class="text-xs text-ink-400 mb-4">คำที่ ' + (uiReviewIdx[langKey] + 1) + ' / ' + learningWords.length + '</p>' +
        '<div data-action="review-flip" class="card-flip ' + (flipped ? 'flipped' : '') + '"><div class="card-flip-inner">' +
        '<div class="card-face bg-ink-50 dark:bg-ink-800"><p class="font-display font-bold text-2xl">' + esc(w.word) + '</p>' +
        (w.pronounce ? '<p class="text-xs text-ink-400 mt-1">' + esc(w.pronounce) + '</p>' : '') + '</div>' +
        '<div class="card-face card-back bg-amber-500/10 p-4"><p class="font-semibold text-lg mb-1">' + esc(w.thai) + '</p><p class="text-xs italic text-ink-400">"' + esc(w.example) + '"</p></div>' +
        '</div></div><p class="text-xs text-ink-400 mt-3">แตะการ์ดเพื่อดูความหมาย (What/อะไร)</p>' +
        '<div class="flex gap-2 mt-4 justify-center">' +
        '<button data-action="review-master" data-id="' + w.id + '" class="px-4 py-2 rounded-full bg-teal-500/20 text-teal-600 dark:text-teal-400 text-sm font-semibold">จำได้แล้ว</button>' +
        '<button data-action="review-next" class="px-4 py-2 rounded-full bg-ink-100 dark:bg-ink-800 text-ink-500 text-sm font-semibold">คำถัดไป</button></div>';
    }
    body = cardOpen('max-w-md mx-auto text-center') + inner + cardClose;
  }
  return roadmap + dailyChecklistBlock(langKey) + tabs + '<div class="mt-6">' + body + '</div>';
}

/* ============================== RENDER: MATH ============================== */
function renderMath() {
  var notesBlock = cardOpen() + '<h2 class="font-display font-semibold text-base mb-2">โน้ตสรุปของฉัน</h2>' +
    '<textarea id="math-notes" rows="3" class="w-full px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none focus:border-teal-500">' + esc(state.math.notes) + '</textarea>' + cardClose;

  var form = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">เพิ่มโจทย์ใหม่</h2>' +
    '<form data-form="add-challenge" class="grid sm:grid-cols-3 gap-2">' +
    '<input name="question" placeholder="โจทย์" required class="sm:col-span-3 px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<input name="hint" placeholder="คำใบ้" class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<input name="answer" placeholder="เฉลย" required class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<button class="px-5 py-3 rounded-xl bg-ink-900 dark:bg-amber-500 text-white dark:text-ink-950 text-base font-semibold">เพิ่มโจทย์</button></form>' + cardClose;

  var grid = '<div class="grid sm:grid-cols-2 gap-4">' + state.math.challenges.map(function (c) {
    var reveal = uiMathRevealed[c.id];
    var inner = '';
    if (!c.solved) {
      inner += '<div class="flex flex-col gap-2">';
      if (reveal === 'hint' || reveal === 'answer') inner += '<p class="text-xs text-ink-400">💡 คำใบ้: ' + esc(c.hint) + '</p>';
      if (reveal === 'answer') inner += '<p class="text-xs font-semibold text-teal-600 dark:text-teal-400">เฉลย: ' + esc(c.answer) + '</p>';
      inner += '<div class="flex gap-1.5 flex-wrap">';
      if (!reveal) inner += '<button data-action="math-reveal" data-id="' + c.id + '" data-status="hint" class="text-xs px-2 py-1 rounded-md bg-ink-100 dark:bg-ink-800 text-ink-500">ดูคำใบ้</button>';
      if (reveal === 'hint') inner += '<button data-action="math-reveal" data-id="' + c.id + '" data-status="answer" class="text-xs px-2 py-1 rounded-md bg-ink-100 dark:bg-ink-800 text-ink-500">ดูเฉลย</button>';
      inner += '<button data-action="math-solve" data-id="' + c.id + '" class="text-xs px-2 py-1 rounded-md bg-amber-500/20 text-amber-600 dark:text-amber-400 font-semibold">ทำได้แล้ว +XP</button></div></div>';
    }
    return cardOpen() + imgThumb(c) + '<div class="flex items-center justify-between mb-2">' + pill(c.difficulty, 'bg-indigo-500/15 text-indigo-500') + editBtn('challenge', c.id) +
      (c.solved ? pill('แก้แล้ว ✓', 'bg-teal-500/15 text-teal-600 dark:text-teal-400') : '') + '</div>' +
      '<p class="text-sm font-medium mb-3">' + esc(c.question) + '</p>' + inner + cardClose;
  }).join('') + '</div>';

  return renderRoadmap('math') + dailyChecklistBlock('math') + notesBlock + form + grid;
}

/* ============================== RENDER: FITNESS ============================== */
function renderFitness() {
  var today = todayStr();
  var todayLog = state.fitness.log[today] || [];
  var checklist = state.fitness.exercises.map(function (ex) {
    var done = todayLog.indexOf(ex.id) !== -1;
    return '<button data-action="fitness-toggle" data-id="' + ex.id + '" class="flex items-center justify-between px-3 py-2.5 rounded-xl border text-left transition-colors w-full ' +
      (done ? 'bg-teal-500/10 border-teal-500/30' : 'bg-ink-50 dark:bg-ink-800/60 border-transparent') + '">' +
      '<span class="text-sm font-medium flex items-center gap-2"><span class="w-5 h-5 rounded-md flex items-center justify-center text-xs ' +
      (done ? 'bg-teal-500 text-white' : 'bg-ink-200 dark:bg-ink-700') + '">' + (done ? '✓' : '') + '</span>' + esc(ex.name) + '</span>' +
      '<span class="text-xs text-ink-400">' + esc(ex.target) + '</span></button>';
  }).join('');

  var todayBlock = cardOpen() + '<div class="flex items-center justify-between mb-3"><h2 class="font-display font-semibold text-base">เช็คลิสต์วันนี้</h2>' +
    '<span class="text-xs text-ink-400">' + todayLog.length + '/' + state.fitness.exercises.length + ' เสร็จแล้ว</span></div>' +
    progressBar((todayLog.length / state.fitness.exercises.length) * 100, 'bg-rose-500') +
    '<div class="flex flex-col gap-2 mt-4">' + checklist + '</div>' + cardClose;

  var dayShort = ['อา','จ','อ','พ','พฤ','ศ','ส'];
  var last7 = [];
  for (var i = 6; i >= 0; i--) last7.push(todayStr(-i));
  var week = last7.map(function (d) {
    var count = (state.fitness.log[d] || []).length;
    var full = count === state.fitness.exercises.length;
    var dow = dayShort[new Date(d).getDay()];
    return '<div class="flex flex-col items-center gap-1"><div class="w-9 h-9 rounded-lg flex items-center justify-center text-xs font-semibold ' +
      (full ? 'bg-rose-500 text-white' : (count > 0 ? 'bg-rose-500/30' : 'bg-ink-100 dark:bg-ink-800')) + '">' + count + '</div>' +
      '<span class="text-[10px] text-ink-400">' + dow + '</span></div>';
  }).join('');
  var weekBlock = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">7 วันล่าสุด</h2><div class="grid grid-cols-7 gap-2">' + week + '</div>' + cardClose;

  var manageBlock = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">⚙️ จัดการท่าออกกำลังกาย</h2>' +
    state.fitness.exercises.map(function (ex) { return '<div class="flex items-center justify-between gap-2 py-2 border-b border-ink-100 dark:border-ink-800 last:border-0"><div class="flex items-center gap-3 min-w-0">' + imgThumb(ex, 'w-12 h-12 rounded-lg object-cover shrink-0 cursor-zoom-in') + '<div class="min-w-0"><p class="text-sm font-medium">' + esc(ex.name) + '</p><p class="text-xs text-ink-400">' + esc(ex.target) + '</p></div></div>' + editBtn('exercise', ex.id) + '</div>'; }).join('') +
    '<div class="flex flex-wrap gap-2 mt-3"><input id="exName" placeholder="ชื่อท่าใหม่" class="flex-1 min-w-[120px] px-3 py-2.5 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<input id="exTarget" placeholder="เป้าหมาย เช่น 10 ครั้ง" class="flex-1 min-w-[120px] px-3 py-2.5 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<button onclick="addExercise()" class="shrink-0 px-4 py-2.5 rounded-lg bg-ink-900 dark:bg-amber-500 text-white dark:text-ink-950 text-sm font-semibold">+ เพิ่มท่า</button></div>' + cardClose;
  return renderRoadmap('fitness') + todayBlock + weekBlock + manageBlock;
}

/* ============================== RENDER: FINANCE ============================== */
function renderFinance() {
  var income = state.finance.transactions.filter(function (t) { return t.type === 'income'; }).reduce(function (a, t) { return a + t.amount; }, 0);
  var expense = state.finance.transactions.filter(function (t) { return t.type === 'expense'; }).reduce(function (a, t) { return a + t.amount; }, 0);
  var balance = income - expense;
  var spentByCat = {};
  state.finance.transactions.filter(function (t) { return t.type === 'expense'; }).forEach(function (t) { spentByCat[t.category] = (spentByCat[t.category] || 0) + t.amount; });

  var summary = '<div class="grid grid-cols-3 gap-3">' +
    cardOpen('!p-4') + '<p class="text-xs text-ink-400">รายรับรวม</p><p class="font-mono font-semibold text-lg text-teal-500">' + fmtThb(income) + '</p>' + cardClose +
    cardOpen('!p-4') + '<p class="text-xs text-ink-400">รายจ่ายรวม</p><p class="font-mono font-semibold text-lg text-rose-500">' + fmtThb(expense) + '</p>' + cardClose +
    cardOpen('!p-4') + '<p class="text-xs text-ink-400">คงเหลือ</p><p class="font-mono font-semibold text-lg">' + fmtThb(balance) + '</p>' + cardClose + '</div>';

  var form = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">บันทึกรายการใหม่</h2>' +
    '<form data-form="add-transaction" class="grid sm:grid-cols-4 gap-2">' +
    '<select name="type" class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none"><option value="expense">รายจ่าย</option><option value="income">รายรับ</option></select>' +
    '<input name="category" placeholder="หมวดหมู่" required class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<input name="amount" type="number" step="0.01" min="0" placeholder="จำนวนเงิน (บาท)" required class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<input name="note" placeholder="โน้ต (ถ้ามี)" class="px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<button class="sm:col-span-4 px-5 py-3 rounded-xl bg-ink-900 dark:bg-amber-500 text-white dark:text-ink-950 text-base font-semibold">บันทึกรายการ</button></form>' + cardClose;

  var budgetRows = Object.keys(state.finance.budgets).map(function (cat) {
    var budget = state.finance.budgets[cat];
    var spent = spentByCat[cat] || 0;
    var over = spent > budget;
    return '<div><div class="flex justify-between text-xs mb-1"><span class="font-medium flex items-center gap-2">' + esc(cat) + editBtn('budget', cat) + '</span>' +
      '<span class="' + (over ? 'text-rose-500 font-semibold' : 'text-ink-400') + '">' + fmtThb(spent) + ' / ' + fmtThb(budget) + '</span></div>' +
      progressBar((spent / budget) * 100, over ? 'bg-rose-500' : 'bg-teal-500') + '</div>';
  }).join('');
  var budgetBlock = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">งบประมาณตามหมวดหมู่</h2><div class="flex flex-col gap-3">' + budgetRows + '</div>' + cardClose;

  var goalRows = state.finance.goals.map(function (g) {
    return '<div>' + imgThumb(g) + '<div class="flex justify-between text-xs mb-1"><span class="font-medium flex items-center gap-2">' + esc(g.name) + editBtn('goal', g.id) + '</span><span class="text-ink-400">' + fmtThb(g.saved) + ' / ' + fmtThb(g.target) + '</span></div>' +
      progressBar((g.saved / g.target) * 100, 'bg-amber-500') +
      '<button data-action="goal-add" data-id="' + g.id + '" class="text-xs mt-1.5 px-2 py-1 rounded-md bg-amber-500/15 text-amber-600 dark:text-amber-400 font-semibold">+ ออม 500 ฿</button></div>';
  }).join('');
  var goalBlock = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">เป้าหมายการออม</h2><div class="flex flex-col gap-4">' + goalRows + '</div>' + cardClose;

  var txRows = state.finance.transactions.slice(0, 15).map(function (t) {
    return '<div class="flex items-center justify-between text-sm py-1.5 border-b border-ink-100 dark:border-ink-800 last:border-0">' +
      '<div class="flex items-center gap-2">' + imgThumb(t, 'w-10 h-10 rounded-md object-cover shrink-0 cursor-zoom-in') + '<div><p class="font-medium">' + esc(t.category) + '</p><p class="text-xs text-ink-400">' + t.date + (t.note ? ' · ' + esc(t.note) : '') + '</p></div></div>' +
      '<span class="flex items-center gap-2"><span class="font-semibold text-sm ' + (t.type === 'income' ? 'text-teal-500' : 'text-rose-500') + '">' + (t.type === 'income' ? '+' : '-') + fmtThb(t.amount) + '</span>' + editBtn('tx', t.id) + '</span></div>';
  }).join('');
  var txBlock = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">รายการล่าสุด</h2><div class="flex flex-col gap-1.5 max-h-72 overflow-y-auto">' + txRows + '</div>' + cardClose;

  var salary = state.finance.salary || 0;
  var emLow = salary * 3, emHigh = salary * 6, saveLow = Math.round(salary * 0.1), saveHigh = Math.round(salary * 0.2);
  var adviceBlock = cardOpen() + '<h2 class="font-display font-semibold text-base mb-3">💡 เงินสำรองฉุกเฉิน & แนะนำการลงทุน</h2>' +
    '<div class="flex gap-2 mb-4"><input id="salaryInput" type="number" min="0" placeholder="เงินเดือน (บาท/เดือน)" value="' + (salary || '') + '" class="flex-1 px-3 py-2 rounded-lg bg-ink-50 dark:bg-ink-800 border border-ink-200 dark:border-ink-700 text-sm outline-none" />' +
    '<button onclick="setSalary()" class="shrink-0 px-5 py-3 rounded-xl bg-ink-900 dark:bg-amber-500 text-white dark:text-ink-950 text-base font-semibold">บันทึก</button></div>' +
    (salary ? (
      '<div class="flex flex-col gap-3 text-sm">' +
      '<div class="p-3 rounded-xl bg-ink-50 dark:bg-ink-800/60"><p class="font-medium mb-1">🛟 เงินสำรองฉุกเฉินที่ควรมี</p><p class="text-ink-500 dark:text-ink-400">ประมาณ <b>' + fmtThb(emLow) + ' – ' + fmtThb(emHigh) + '</b> (3–6 เท่าของเงินเดือน) กันไว้เผื่อตกงาน/เจ็บป่วยกะทันหัน เก็บในที่ถอนง่าย เช่น บัญชีออมทรัพย์ดอกเบี้ยสูง</p></div>' +
      '<div class="p-3 rounded-xl bg-ink-50 dark:bg-ink-800/60"><p class="font-medium mb-1">📈 พร้อมเริ่มลงทุนเมื่อไหร่</p><p class="text-ink-500 dark:text-ink-400">เมื่อมีเงินสำรองฉุกเฉินครบตามข้างต้น และไม่มีหนี้ดอกเบี้ยสูงค้างอยู่ (เช่นบัตรเครดิต) ค่อยเริ่มลงทุนแบบสม่ำเสมอทุกเดือน (DCA) ในสินทรัพย์ที่กระจายความเสี่ยง เช่นกองทุนดัชนี</p></div>' +
      '<div class="p-3 rounded-xl bg-teal-500/10 border border-teal-500/20"><p class="font-medium mb-1">💰 แนะนำออม/ลงทุนต่อเดือน</p><p class="text-ink-500 dark:text-ink-400">ประมาณ <b>' + fmtThb(saveLow) + ' – ' + fmtThb(saveHigh) + '</b> ต่อเดือน (10–20% ของเงินเดือน) — ช่วงแรกให้ไหลเข้ากองทุนสำรองฉุกเฉินก่อน พอครบเป้าค่อยสลับไปลงทุนแทน</p></div>' +
      '<p class="text-[11px] text-ink-400">* เป็นคำแนะนำทั่วไปตามหลักวางแผนการเงินพื้นฐาน ไม่ใช่คำแนะนำเฉพาะบุคคล ควรพิจารณาตามสถานการณ์จริงหรือปรึกษาผู้เชี่ยวชาญด้านการเงินเพิ่มเติม</p></div>'
    ) : '<p class="text-sm text-ink-400">กรอกเงินเดือนก่อน เพื่อรับคำแนะนำเงินสำรองฉุกเฉินและจำนวนที่ควรออม/ลงทุนต่อเดือน</p>') + cardClose;

  return renderRoadmap('finance') + summary + adviceBlock + form + budgetBlock + goalBlock + txBlock;
}
function setSalary() { var el = document.getElementById('salaryInput'); state.finance.salary = parseFloat(el.value) || 0; saveData(); render(); }

