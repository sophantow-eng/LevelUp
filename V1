/* ============================== FOCUS TIMER (โฟกัสจับเวลา) ============================== */
var focusT = { total: 25 * 60, left: 25 * 60, running: false, iv: null, endAt: 0 };
function fmtMMSS(sec) { sec = Math.max(0, sec); return String(Math.floor(sec / 60)).padStart(2, '0') + ':' + String(sec % 60).padStart(2, '0'); }
function focusTick() {
  focusT.left = Math.ceil((focusT.endAt - Date.now()) / 1000);
  var el = document.getElementById('focus-time'), bar = document.getElementById('focus-bar');
  if (el) el.textContent = fmtMMSS(focusT.left);
  if (bar) bar.style.width = Math.min(100, (focusT.total - focusT.left) / focusT.total * 100) + '%';
  if (focusT.left <= 0) {
    clearInterval(focusT.iv); focusT.running = false;
    var mins = Math.round(focusT.total / 60); focusT.left = focusT.total;
    addXp(Math.max(5, Math.round(mins * 0.6)), 'โฟกัสครบ ' + mins + ' นาที'); saveData(); render();
  }
}
function focusToggle() {
  if (focusT.running) { clearInterval(focusT.iv); focusT.running = false; focusT.left = Math.ceil((focusT.endAt - Date.now()) / 1000); }
  else { focusT.running = true; focusT.endAt = Date.now() + focusT.left * 1000; focusT.iv = setInterval(focusTick, 1000); }
  render();
}
function focusReset() { clearInterval(focusT.iv); focusT.running = false; focusT.left = focusT.total; render(); }
function focusSet(m) { if (focusT.running) { showToast('หยุดจับเวลาก่อนเปลี่ยนเวลา'); return; } focusT.total = m * 60; focusT.left = focusT.total; render(); }
function focusTimerBlock() {
  var pct = (focusT.total - focusT.left) / focusT.total * 100;
  var presets = [15, 25, 45].map(function (m) {
    var on = focusT.total === m * 60;
    return '<button onclick="focusSet(' + m + ')" class="flex-1 py-2.5 rounded-lg text-sm font-semibold ' + (on ? 'bg-amber-500/20 text-amber-600 dark:text-amber-400' : 'bg-ink-100 dark:bg-ink-800 text-ink-500') + '">' + m + ' นาที</button>';
  }).join('');
  return cardOpen('mb-6') + '<div class="flex items-center justify-between mb-2"><h2 class="font-display font-semibold text-base">⏱️ โฟกัสจับเวลา</h2><span class="text-xs text-ink-400">ครบเวลา = ได้ XP</span></div>' +
    '<p id="focus-time" class="font-mono font-bold text-5xl text-center my-3">' + fmtMMSS(focusT.left) + '</p>' +
    '<div class="w-full h-2 rounded-full overflow-hidden bg-ink-200 dark:bg-ink-800 mb-4"><div id="focus-bar" class="h-full rounded-full bg-amber-500" style="width:' + pct + '%"></div></div>' +
    '<div class="flex gap-2 mb-2">' + presets + '</div>' +
    '<div class="flex gap-2"><button onclick="focusToggle()" class="flex-1 py-3.5 rounded-xl bg-ink-900 dark:bg-amber-500 text-white dark:text-ink-950 font-semibold">' + (focusT.running ? '⏸ หยุดชั่วคราว' : (focusT.left < focusT.total ? '▶ ทำต่อ' : '▶ เริ่มโฟกัส')) + '</button>' +
    '<button onclick="focusReset()" class="px-5 py-3.5 rounded-xl bg-ink-100 dark:bg-ink-800 text-ink-500 font-semibold">รีเซ็ต</button></div>' + cardClose;
}

