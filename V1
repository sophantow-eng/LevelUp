/* ============================== IMAGES (รูปภาพ) ============================== */
function isImg(v) { return typeof v === 'string' && v.indexOf('data:image/') === 0; }
function imgThumb(o, cls) {
  if (!o || !isImg(o.image)) return '';
  return '<img src="' + o.image + '" onclick="viewImg(this.src)" alt="รูปภาพ" loading="lazy" class="' + (cls || 'w-full max-h-48 object-cover rounded-xl mb-3 cursor-zoom-in') + '" />';
}
function viewImg(src) {
  if (!isImg(src)) return;
  var v = document.createElement('div');
  v.id = 'img-viewer'; v.className = 'fixed inset-0 z-[70] bg-black/85 flex items-center justify-center p-3';
  v.onclick = function () { v.remove(); };
  v.innerHTML = '<img src="' + src + '" class="max-w-full max-h-full rounded-xl" alt="รูปภาพ" /><button class="absolute top-3 right-3 w-11 h-11 rounded-full bg-white/20 text-white text-xl" aria-label="ปิด">✕</button>';
  document.body.appendChild(v);
}
function compressImage(file, cb) {
  if (!file || file.type.indexOf('image/') !== 0) { showToast('กรุณาเลือกไฟล์รูปภาพ'); return; }
  var fr = new FileReader();
  fr.onerror = function () { showToast('อ่านไฟล์ไม่สำเร็จ'); };
  fr.onload = function () {
    var im = new Image();
    im.onerror = function () { showToast('เปิดรูปนี้ไม่ได้'); };
    im.onload = function () {
      var max = 720, r = Math.min(1, max / Math.max(im.width, im.height));
      var c = document.createElement('canvas'); c.width = Math.round(im.width * r); c.height = Math.round(im.height * r);
      var x = c.getContext('2d'); x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height); x.drawImage(im, 0, 0, c.width, c.height);
      cb(c.toDataURL('image/jpeg', 0.72));
    };
    im.src = fr.result;
  };
  fr.readAsDataURL(file);
}
function editImgHtml() {
  var has = editCtx && isImg(editCtx.image);
  return (has ? '<img src="' + editCtx.image + '" class="w-full max-h-48 object-cover rounded-xl mb-2" alt="ตัวอย่างรูป" />' : '') +
    '<div class="flex gap-2"><label class="flex-1 text-center px-4 py-3 rounded-xl bg-ink-100 dark:bg-ink-800 text-sm font-semibold cursor-pointer">📷 ' + (has ? 'เปลี่ยนรูป' : 'เพิ่มรูป') +
    '<input type="file" accept="image/*" class="hidden" onchange="pickEditImage(this)" /></label>' +
    (has ? '<button type="button" onclick="removeEditImage()" class="px-4 py-3 rounded-xl text-rose-500 text-sm font-semibold border border-rose-500/30">ลบรูป</button>' : '') + '</div>';
}
function pickEditImage(inp) {
